<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_card"
    android:orientation="vertical">

    <!-- Header: Vehicle Info + Time & Date -->
    <LinearLayout
        android:id="@+id/widget_header_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Vehicle Icon & Name -->
        <LinearLayout
            android:id="@+id/widget_vehicle_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_vehicle_icon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_widget_icon_pill"
                android:contentDescription="@string/app_name"
                android:padding="5dp"
                android:src="@drawable/ic_widget_gas_pump" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_vehicle_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="ManaVahana Vehicle"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_vehicle_number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="AP 29 BK 1234 • Petrol"
                    android:textColor="#FFA000"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Simulated Clock & Date for Preview -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10:30 AM"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sat, 26 Sep"
                android:textColor="#B0BEC5"
                android:textSize="10.5sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Fuel Stats Row: Last Fuel, Monthly Fuel, Odometer -->
    <LinearLayout
        android:id="@+id/widget_stats_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <!-- Stat 1: Last Refuel -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_stat"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Last Fill"
                android:textColor="#9E9E9E"
                android:textSize="9.5sp" />

            <TextView
                android:id="@+id/widget_last_fuel_cost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="₹1,500 (14.2L)"
                android:textColor="#81C784"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Stat 2: Month Total -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_stat"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Month Fuel"
                android:textColor="#9E9E9E"
                android:textSize="9.5sp" />

            <TextView
                android:id="@+id/widget_month_fuel_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="₹4,250"
                android:textColor="#FFB74D"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Stat 3: Odometer -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_stat"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Odometer"
                android:textColor="#9E9E9E"
                android:textSize="9.5sp" />

            <TextView
                android:id="@+id/widget_odometer_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="24,580 km"
                android:textColor="#E0E0E0"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Quick Action Bar: Primary 'Add Fuel Expense' + Presets (+₹500, +₹1000) -->
    <LinearLayout
        android:id="@+id/widget_actions_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Primary Quick Add Fuel Button -->
        <LinearLayout
            android:id="@+id/widget_btn_add_fuel"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1.6"
            android:background="@drawable/bg_widget_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_widget_add" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Add Fuel Expense"
                android:textColor="#1A1816"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Quick Preset 1: +₹500 -->
        <TextView
            android:id="@+id/widget_btn_preset_500"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:layout_weight="0.8"
            android:background="@drawable/bg_widget_chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="+₹500"
            android:textColor="#FFA000"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <!-- Quick Preset 2: +₹1000 -->
        <TextView
            android:id="@+id/widget_btn_preset_1000"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:layout_weight="0.8"
            android:background="@drawable/bg_widget_chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="+₹1000"
            android:textColor="#FFA000"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <!-- Quick Refresh Icon Button -->
        <ImageButton
            android:id="@+id/widget_btn_refresh"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_widget_chip"
            android:contentDescription="Refresh Widget"
            android:padding="8dp"
            android:src="@drawable/ic_widget_refresh" />
    </LinearLayout>

</LinearLayout>
